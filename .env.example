# ===================================================================
# Drive-to-AWS Environment Configuration
# ===================================================================
# This file contains all configuration options for the application.
# Copy this file to .env and customize as needed.
# 
# IMPORTANT: AWS and Google credentials are OPTIONAL in this file!
# You can add them via the Settings UI after deployment.
# ===================================================================

# -------------------------------------------------------------------
# Core Database and Message Broker (Required)
# -------------------------------------------------------------------
# These values are pre-configured for Docker Compose deployment
# Change only if using external databases
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/drive
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BACKEND_URL=redis://redis:6379/0

# -------------------------------------------------------------------
# AWS / S3 Configuration (OPTIONAL)
# -------------------------------------------------------------------
# These are FALLBACK credentials only. Leave empty and add credentials
# via the Settings UI instead for better security and flexibility.
# 
# If you want to use environment-based credentials:
# - Uncomment and fill in the values below
# - Or use AWS EC2 IAM roles (recommended for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

# -------------------------------------------------------------------
# Google Drive API Configuration (OPTIONAL)
# -------------------------------------------------------------------
# Only needed for PRIVATE Google Drive folders
# PUBLIC folders work without any Google credentials!
#
# Option 1: API Key (easiest for public folders)
GOOGLE_API_KEY=

# Option 2: Service Account JSON (for private folders)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option 3: Service Account JSON file path (for private folders)
GOOGLE_CREDENTIALS=

# -------------------------------------------------------------------
# API Server Configuration
# -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------------------------------
# Frontend Configuration
# -------------------------------------------------------------------
# For Docker deployment with Nginx proxy, use relative path:
VITE_API_BASE=/api/v1

# For local development, use:
# VITE_API_BASE=http://localhost:8000/api/v1

# For direct EC2 deployment without Nginx, use:
# VITE_API_BASE=http://YOUR_EC2_PUBLIC_IP:8000/api/v1

# -------------------------------------------------------------------
# Security (Auto-generated if not provided)
# -------------------------------------------------------------------
# Encryption key for storing credentials in database
# Leave empty to auto-generate (not recommended for production)
ENCRYPTION_KEY=

# -------------------------------------------------------------------
# Optional: Internal Service URLs (for microservices)
# -------------------------------------------------------------------
IMPORT_SERVICE_URL=http://import-service:8000
METADATA_SERVICE_URL=http://metadata-service:8000

